# --- Core MCP ---
# Comma-separated break-glass API keys (ops/dev; skip ledger debit). Keep alongside customer keys.
API_KEYS=dev-key-1,dev-key-2

# HTTP listen port (default 3000)
PORT=3000

# Bind host (0.0.0.0 for Docker/Fly; 127.0.0.1 for local-only)
HOST=0.0.0.0

# Optional: enable live web fetch for research_brief depth=quick
LIVE_RESEARCH=0

# --- Ledger (SQLite alpha) ---
# Required when billing enabled or customer API keys are used.
# sql.js pure-JS SQLite (better-sqlite3 native build unavailable on this box).
DATABASE_URL=file:./data/ledger.sqlite

# --- Stripe prepaid credits (TEST MODE ONLY until go-live) ---
# Secret key — sk_test_… only; never commit real values; no sk_live_ until Michael approves.
STRIPE_SECRET_KEY=sk_test_placeholder

# Webhook signing secret from Dashboard endpoint or Stripe CLI (whsec_…)
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# One-time Price IDs for credit packs (create in Stripe Dashboard Test mode — out of band)
STRIPE_PRICE_CREDITS_10=price_test_credits_10_placeholder
STRIPE_PRICE_CREDITS_25=price_test_credits_25_placeholder
STRIPE_PRICE_CREDITS_50=price_test_credits_50_placeholder

# Optional publishable key if a browser starts Checkout (server-only create works without it)
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

# Checkout redirects — swap localhost for Fly URL when known
BILLING_SUCCESS_URL=http://localhost:3000/billing/success?session_id={CHECKOUT_SESSION_ID}
BILLING_CANCEL_URL=http://localhost:3000/billing/cancel
